rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email']) &&
             data.uid is string &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() < 100 &&
             data.email is string;
    }
    function isValidVideo(data) {
      return data.keys().hasAll(['uploaderUid', 'title', 'videoUrl', 'createdAt']) &&
             data.uploaderUid == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.videoUrl is string;
    }
    function isValidDocument(data) {
      return data.keys().hasAll(['uploaderUid', 'title', 'fileUrl', 'createdAt']) &&
             data.uploaderUid == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.fileUrl is string;
    }
    function isValidClassroom(data) {
      return data.keys().hasAll(['name', 'creatorUid', 'createdAt']) &&
             data.creatorUid == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100;
    }
    function isValidMessage(data) {
      return data.keys().hasAll(['classroomId', 'senderUid', 'text', 'createdAt']) &&
             data.senderUid == request.auth.uid &&
             data.text is string && data.text.size() > 0 && data.text.size() < 1000;
    }
    function isValidNotification(data) {
      return data.keys().hasAll(['recipientUid', 'senderUid', 'senderName', 'type', 'targetId', 'read', 'createdAt']) &&
             data.recipientUid is string &&
             data.senderUid == request.auth.uid &&
             data.type in ['follow', 'like', 'message'] &&
             data.read == false;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
    }

    match /videos/{videoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidVideo(request.resource.data);
      allow update: if isAuthenticated() && (request.resource.data.uploaderUid == resource.data.uploaderUid) && (
        (request.auth.uid == resource.data.uploaderUid) || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']))
      );
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.uploaderUid;
    }

    match /documents/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidDocument(request.resource.data);
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.uploaderUid;
    }

    match /classrooms/{classroomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidClassroom(request.resource.data);
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.creatorUid || request.auth.uid in resource.data.members);
      
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isValidMessage(request.resource.data);
      }
    }

    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.followerUid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.followerUid == request.auth.uid;
    }

    match /likes/{likeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userUid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userUid == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
      allow create: if isAuthenticated() && isValidNotification(request.resource.data);
      allow update: if isAuthenticated() && resource.data.recipientUid == request.auth.uid && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
    }
  }
}
